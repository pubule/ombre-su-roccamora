{
  // La webapp e' fatta di file statici (webapp/server.js serve solo file), piu'
  // gli endpoint /api/ dei salvataggi per account. La cartella la assembla
  // deploy/build-dist.sh: i mount /data /assets /fonts stanno fuori da public/.
  "name": "ombre-su-roccamora",
  // 2026-08-08 e non il 09: il workerd che wrangler 4.120.0 si porta dietro
  // non conosce ancora date piu' recenti, e `wrangler dev` non parte.
  "compatibility_date": "2026-08-08",
  "main": "./webapp/worker/index.js",
  // dist e' una COPIA: senza questo, un `wrangler deploy` lanciato a mano —
  // saltando deploy.sh — pubblica la copia vecchia e la correzione resta a
  // terra, con tutti i banchi verdi. E' successo l'11/08/2026 col tag <font>
  // delle lettere. Cosi' la cartella si riassembla comunque, sempre.
  // «bash ...» e non «./...»: su Windows il comando lo lancia cmd.exe, che di
  // uno script sh non sa cosa fare.
  "build": { "command": "bash ./deploy/build-dist.sh" },
  "assets": { "directory": "./webapp/dist", "binding": "ASSETS" },
  // L'applicazione Access che sta davanti a questo Worker. ACCESS_AUD e' il suo
  // Application Audience tag: il Worker rifiuta i token emessi per un'ALTRA
  // applicazione dello stesso team, che altrimenti sarebbero firme valide.
  // Non sono segreti (stanno nel redirect di login), quindi vars e non secret.
  // LA PORTA (webapp/worker/porta.js): l'app aggiunge al criterio di Access gli
  // indirizzi delle persone in rubrica, che era l'unico passaggio rimasto sulla
  // dashboard — e quindi l'unico che si dimenticava.
  //
  // Questi non sono segreti: l'id dell'account sta nell'URL della dashboard,
  // quello del criterio pure, e i portieri sono indirizzi che l'app gia'
  // mostra. Il TOKEN invece e' un segreto e non sta qui: si crea a mano (My
  // Profile -> API Tokens, permesso «Account · Access: Apps and Policies ·
  // Edit») e si carica con `npx wrangler secret put CF_API_TOKEN`.
  //
  // Senza quel segreto niente cambia: nessuna chiamata parte, e la rubrica dice
  // che la porta non e' collegata invece di offrire un bottone che fallisce.
  "vars": {
    "ACCESS_TEAM": "smartcores",
    "ACCESS_AUD": "a88f2f39cac5993fe0c75acfec3aece7a19d67d2a97a861a45d84777103e1128",
    "CF_ACCOUNT_ID": "3f078eb974edf09669ceca41a0264a1f",
    "ACCESS_POLICY_ID": "34023781-5e10-4008-9363-fa19e15c7215",
    // chi puo' aprire la porta dall'app; vuoto = funzione spenta
    "PORTIERI": "pubule@gmail.com"
  },
  // Questo nome e' anche una destinazione dell'applicazione Access (tipo «nome
  // host pubblico»), quindi nasce protetto: Access ci rimanda dopo il login, ed
  // e' il motivo per cui deve esistere. L'indirizzo workers.dev resta acceso e
  // protetto anche lui dalla destinazione di tipo Workers.
  "routes": [
    { "pattern": "roccamora.smartcores.org", "custom_domain": true }
  ],
  // LA PARTITA VIVA (DESIGN-VISTA-EROE.md): un Durable Object per tavolo, che
  // fa da arbitro quando piu' dispositivi giocano la stessa serata. Backend
  // SQLite — l'unico che si possa creare oggi, ed e' quello disponibile anche
  // sul piano gratuito.
  "durable_objects": {
    "bindings": [{ "name": "PARTITA", "class_name": "Partita" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Partita"] }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "ombre-salvataggi", "database_id": "b0a85d9c-e7a6-4c3b-8940-1a50ad87fee2" }
  ]
}
