{
  // Worker di soli asset statici: la webapp non ha backend (webapp/server.js
  // serve solo file), quindi niente "main" — Cloudflare serve webapp/dist.
  // La cartella la assembla webapp/build-dist.sh (i mount /data /assets
  // /fonts stanno fuori da public/).
  "name": "ombre-su-roccamora",
  "compatibility_date": "2026-08-09",
  "assets": { "directory": "./webapp/dist" }
}
